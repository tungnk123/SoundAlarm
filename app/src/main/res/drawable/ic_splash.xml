<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash-screen icon: the alarm clock is scaled to ~70% of the viewport and
    centred via pivotX/pivotY so it doesn't feel too large inside the
    Android 12+ 160 dp splash circle.
-->
