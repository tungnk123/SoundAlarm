    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Right bell ear -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M22,5.72L17.4,1.86L16.11,3.39L20.71,7.25L22,5.72Z" />

        <!-- Left bell ear -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M5.6,1.86L1,5.71L2.29,7.24L6.89,3.38L5.6,1.86Z" />

        <!-- Clock ring -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M12,4C7.03,4 3,8.03 3,13C3,17.97 7.03,22 12,22C16.97,22 21,17.97 21,13C21,8.03 16.97,4 12,4ZM12,6C8.13,6 5,9.13 5,13C5,16.87 8.13,20 12,20C15.87,20 19,16.87 19,13C19,9.13 15.87,6 12,6Z" />

